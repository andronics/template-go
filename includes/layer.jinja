[#!
  Named values the template files share, so a command is spelt once. Not rendered into
  projects: files load it with
      [% import 'includes/layer.jinja' as layer with context %]
  and use [[ layer.<name> ]]. includes/ also holds the blocks several files include
  (Dockerfile stages, wiki fragments). Shaped as template-python's, so the files the stacks
  share stay reviewable line by line against it (docs/decisions/0001).
!#]
[#! ---- identity ---- !#]
[% set name = 'Go' %]
[% set release_type = 'go' %]
[% set version_file = ('internal/version/version.go' if has_cli else 'version.go') %]
[% set code_lang = 'go' %]
[% set topic = 'go' %]
[#! ---- commands (AGENTS.md, README, wiki, PR template) ---- !#]
[% set install = 'go mod download' %]
[% set add_dependency = '`go get <module>` (then `go mod tidy`)' %]
[% set lint = 'golangci-lint run' %]
[% set lint_fix = 'golangci-lint run --fix' %]
[% set format = 'golangci-lint fmt' %]
[% set format_check = 'golangci-lint fmt --diff' %]
[% set typecheck = 'go vet ./...' %]
[% set test = 'sh scripts/test.sh' %]
[% set test_integration = 'go test -tags integration ./tests/integration/...' %]
[% set gen_wiki = 'go run ./scripts/gen-wiki' %]
[% set run = 'go run ./cmd/' ~ project_name %]
[% set install_cli = 'go install ' ~ module_path ~ '/cmd/' ~ project_name ~ '@latest' %]
[% set install_lib = 'go get ' ~ module_path %]
[% set import_snippet = 'import "' ~ module_path ~ '"' %]
[% set public_api = '`' ~ module_path ~ '` (the package at the module root)' %]
[% set suppressions = '`//nolint`' %]
[#! ---- what assistants must not read (AGENTS.md "Don't read"; .claude/settings.json denies) ---- !#]
[% set lock_file = 'go.sum' %]
[% set deps_query = 'go list -m all' %]
[% set noread = ['coverage.out', 'dist/'] %]
[#! ---- source files the docs map and docs-touched check point at ---- !#]
[% set config_file = 'internal/config/config.go' %]
[% set cli_file = 'internal/cli/cli.go' %]
[% set api_file = 'internal/api/api.go' %]
[#! ---- release notes on the Release-Process page (empty if not needed) ---- !#]
[#! go.sum holds no version of the project itself: nothing to refresh. !#]
[% set release_lock_note = '' %]
[#! ---- container and host install ---- !#]
[% set runtime = 'Go' %]
[% set base_image = 'golang' %]
[% set container_base = 'golang:' ~ go_version %]
[#! the runtime stage's image is spelt in the Dockerfile itself, where Renovate's dockerfile manager reads its digest !#]
[% set container_bin_dir = '/usr/local/bin' %]
[% set container_bin = '/usr/local/bin/' ~ project_name %]
[% set release_binary = project_name ~ '_X.Y.Z_linux_amd64' %]
[% set systemd_upgrade = 'download the new release\'s `' ~ release_binary ~ '` (or `_arm64`) to `/usr/local/bin/' ~ project_name ~ '`' %]
