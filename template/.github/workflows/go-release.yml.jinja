# Template-owned: template-go. Versioning and CHANGELOG.md, from Conventional Commits.
#
# Every push to main updates one open "Release PR" that bumps the version and
# writes the CHANGELOG entry. A human reviews and merges it; that tags vX.Y.Z and
# publishes the GitHub Release[% if has_cli %], and the `binaries` job attaches GoReleaser's
# static binaries and checksums.txt to it (only release-please tags)[% endif %][% if container_image %];
# template-container's container-build.yml then builds the release image (it follows
# this workflow by its name, Release)[% endif %]. See the wiki's Release-Process page.
#
# Token: PRs and tags made with GITHUB_TOKEN don't trigger other workflows, so
# CI would not run on the Release PR. Set the organisation variable
# RELEASE_APP_CLIENT_ID and secret RELEASE_APP_PRIVATE_KEY (a GitHub App with
# contents + pull-requests write) and this uses the App instead.
name: Release

on:
  push:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: write
  pull-requests: write
  issues: write

concurrency:
  group: release-please
  cancel-in-progress: false

jobs:
  release-please:
    runs-on: ubuntu-latest
    outputs:
      release_created: ${{ steps.release.outputs.release_created }}
      tag_name: ${{ steps.release.outputs.tag_name }}
      pr: ${{ steps.release.outputs.pr }}
    steps:
      - id: app-token
        if: vars.RELEASE_APP_CLIENT_ID != ''
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          client-id: ${{ vars.RELEASE_APP_CLIENT_ID }}
          private-key: ${{ secrets.RELEASE_APP_PRIVATE_KEY }}

      - id: release
        uses: googleapis/release-please-action@45996ed1f6d02564a971a2fa1b5860e934307cf7 # v5.0.0
        with:
          token: ${{ steps.app-token.outputs.token || github.token }}
          config-file: release-please-config.json
          manifest-file: .release-please-manifest.json

[% if has_cli %]

  # GoReleaser on the tag release-please just made: static binaries (CGO_ENABLED=0,
  # linux and darwin, amd64 and arm64) and checksums.txt, attached to that release
  # (.goreleaser.yaml: release.mode keep-existing, changelog off, no images). It
  # never tags. A failure fails this run; rerun the job once the cause is fixed.
  binaries:
    name: Release binaries
    needs: release-please
    if: needs.release-please.outputs.release_created == 'true'
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ needs.release-please.outputs.tag_name }}
          fetch-depth: 0

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version-file: go.mod

      # GoReleaser at a pinned version (Renovate moves it with stack-ci.yml's).
      - uses: goreleaser/goreleaser-action@a4f02ab5355a589de60d917a659ce617ed19b3de # v7.3.0
        with:
          version: v2.19.0
          args: release --clean
        env:
          GITHUB_TOKEN: ${{ github.token }}
[% endif %]
