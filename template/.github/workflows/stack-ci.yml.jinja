# Template-owned: template-go. The stack slot base-ci.yml's required `ci` job calls:
# the jobs that need Go. Cheap checks (the wiki standard and the version) run in base-ci's
# `checks` job through scripts/checks.d/20-go.sh.
name: Stack

on:
  workflow_call:

permissions:
  contents: read

jobs:
[% set gos = ['1.26', '1.27'] | select('ge', go_version) | list %]
  test:
    name: Test (Go ${{ matrix.go-version }})
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        go-version: [[ gos | tojson ]]
    env:
      # The matrix's Go, never a newer one go.mod asks for.
      GOTOOLCHAIN: local
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
[% if has_cli %]
        with:
          # GoReleaser's snapshot reads the tags.
          fetch-depth: 0
[% endif %]

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: ${{ matrix.go-version }}

      # The `build:` packages in contrib/system-packages.txt (project-owned), for
      # tools the build needs. None listed: nothing is installed.
      - name: System packages
        run: |
          if grep -q '^build:.*[^[:space:]]' contrib/system-packages.txt; then
            sudo apt-get update
            sed -n 's/^build://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

      - name: go.mod and go.sum are tidy
        run: go mod tidy -diff

      - name: Modules match go.sum
        run: go mod verify

      # golangci-lint at a pinned version (Renovate moves it with .pre-commit-config.yaml's rev).
      - uses: golangci/golangci-lint-action@ba0d7d2ec06a0ea1cb5fa41b2e4a3ab91d21278a # v9.3.0
        with:
          version: v2.15.0
          install-only: true

      - name: Format
        run: golangci-lint fmt --diff

      - name: Lint
        run: golangci-lint run

      - name: Vet
        run: go vet ./...

      - name: Tests (race detector, coverage floor)
        run: sh scripts/test.sh

[% if has_cli %]
      - name: CLI smoke test
        run: |
          go run ./cmd/[[ project_name ]] --help > /dev/null
          go run ./cmd/[[ project_name ]] version

[% else %]
      - name: Build
        run: go build ./...

[% endif %]
      - name: Generated wiki sections are current
        if: matrix.go-version == '[[ go_version ]]'
        run: go run ./scripts/gen-wiki --check
[% if has_cli %]

      # GoReleaser at a pinned version (Renovate moves it with go-release.yml's).
      - uses: goreleaser/goreleaser-action@a4f02ab5355a589de60d917a659ce617ed19b3de # v7.3.0
        if: matrix.go-version == '[[ go_version ]]'
        with:
          version: v2.19.0
          install-only: true

      # The release binaries, built as the release builds them (static: a cgo-only
      # import fails here), never published.
      - name: GoReleaser config and a snapshot build
        if: matrix.go-version == '[[ go_version ]]'
        run: |
          goreleaser check
          goreleaser release --snapshot --clean
          ls dist/
[% endif %]
[% if integration_ci %]

  # The Copier answer `integration_ci`: tests/integration/, behind the `integration` build
  # tag (template-go decision 0001, as template-typescript's 0002). It fails, never passes
  # vacuously, when no test passes or one is skipped (a missing package, device or service).
  # On the minimum Go only.
  integration:
    name: Integration tests
    runs-on: ubuntu-latest
    env:
      GOTOOLCHAIN: local
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1

      - uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: "[[ go_version ]]"

      # Both lists in contrib/system-packages.txt: `build:` to build the tests,
      # `runtime:` for the tests to use.
      - name: System packages
        run: |
          if grep -qE '^(build|runtime):.*[^[:space:]]' contrib/system-packages.txt; then
            sudo apt-get update
            sed -nE 's/^(build|runtime)://p' contrib/system-packages.txt | xargs sudo apt-get install -y --no-install-recommends
          fi

      # go test passes with no tests, so the next step reads its report. The coverage
      # floor is the Test job's.
      - name: Integration tests
        run: |
          status=0
          go test -tags integration -json ./tests/integration/... > "$RUNNER_TEMP/integration.json" || status=$?
          # The tests' own output, as go test prints it without -json.
          python3 - "$RUNNER_TEMP/integration.json" <<'EOF'
          import json
          import sys

          for line in open(sys.argv[1], encoding="utf-8"):
              try:
                  event = json.loads(line)
              except ValueError:
                  sys.stdout.write(line)
                  continue
              sys.stdout.write(event.get("Output", ""))
          EOF
          exit "$status"

      # go test -json reports each test's result as an event: "pass", "fail" or "skip".
      - name: An integration test passed, and none was skipped
        run: |
          python3 - "$RUNNER_TEMP/integration.json" <<'EOF'
          import json
          import sys
          from pathlib import Path

          report = Path(sys.argv[1])
          if not report.is_file():
              print(f"::error::no test report at {report}: go test -json didn't run")
              sys.exit(1)
          events = []
          for line in report.read_text(encoding="utf-8").splitlines():
              try:
                  events.append(json.loads(line))
              except ValueError:
                  continue
          tests = [e for e in events if e.get("Test")]
          passed = [e for e in tests if e.get("Action") == "pass"]
          skipped = [f"{e.get('Package')} {e.get('Test')}" for e in tests if e.get("Action") == "skip"]
          if not passed:
              print("::error::no integration test passed: add one to tests/integration/")
          for test in skipped:
              print(f"::error::skipped {test}")
          sys.exit(1 if skipped or not passed else 0)
          EOF
[% endif %]

  markdown:
    name: Markdown lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      # The image, globs and config live in the script, so a local run matches this one.
      - name: markdownlint
        run: scripts/check-markdown.sh
[% if container_image or contrib %]

  manifests:
    name: Dockerfile and contrib manifests
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - name: Install validators
        run: |
          mkdir -p "$HOME/.local/bin"
[% if container_image %]
          curl -fsSL -o "$HOME/.local/bin/hadolint" \
            https://github.com/hadolint/hadolint/releases/download/v2.15.1/hadolint-linux-x86_64
          chmod +x "$HOME/.local/bin/hadolint"
[% endif %]
[% if 'k8s' in contrib %]
          curl -fsSL https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz \
            | tar -xz -C "$HOME/.local/bin" kubeconform
[% endif %]
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
      - name: Validate
        run: scripts/check-manifests.sh
[% endif %]
