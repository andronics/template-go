# Template-owned: template-go. The same checks as CI, before each commit:
#   uv tool install pre-commit && pre-commit install -t pre-commit -t commit-msg
repos:
  # golangci-lint at CI's version (stack-ci.yml's `version:`): Renovate moves both together.
  - repo: https://github.com/golangci/golangci-lint
    rev: v2.15.0
    hooks:
      - id: golangci-lint-fmt
      - id: golangci-lint-full
      - id: golangci-lint-config-verify
  - repo: local
    hooks:
      - id: go-vet
        name: go vet
        entry: go vet ./...
        language: system
        types: [go]
        pass_filenames: false
      - id: go-mod-tidy
        name: go mod tidy -diff
        entry: go mod tidy -diff
        language: system
        files: (\.go|^go\.mod|^go\.sum)$
        pass_filenames: false
      - id: gen-wiki
        name: generated wiki sections
        entry: go run ./scripts/gen-wiki --check
        language: system
        pass_filenames: false
        files: (\.go$|^docs/wiki/)
      # Every template's cheap checks: the stack contract, the wiki standard and the version.
      - id: checks
        name: scripts/checks.sh
        entry: sh scripts/checks.sh
        language: system
        pass_filenames: false
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.30.1
    hooks:
      - id: gitleaks
  - repo: https://github.com/compilerla/conventional-pre-commit
    rev: v4.4.0
    hooks:
      - id: conventional-pre-commit
        stages: [commit-msg]
