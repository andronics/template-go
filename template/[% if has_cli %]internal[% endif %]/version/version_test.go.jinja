package version

import (
	"regexp"
	"testing"
)

func TestVersionIsSemver(t *testing.T) {
	if !regexp.MustCompile(`^\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?$`).MatchString(Version) {
		t.Fatalf("Version %q is not semver", Version)
	}
}

func TestRevisionHasADefault(t *testing.T) {
	if Revision == "" {
		t.Fatal("Revision is empty: a build that sets no -X must leave it \"unknown\"")
	}
}
