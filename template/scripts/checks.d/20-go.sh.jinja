#!/bin/sh
# Template-owned: template-go. The Go stack's cheap checks, run by scripts/checks.sh (and so
# by base-ci's `checks` job and pre-commit): the wiki standard and the version. sed and python3
# only, so base-ci's `checks` job needs no Go: lint, vet, tests and `go mod tidy -diff` run in
# stack-ci.yml. Quiet on a pass: one line.
set -eu
cd "$(dirname "$0")/../.."

# Release PRs are strict: nothing ships while a page still holds skeleton guidance.
case "${GITHUB_HEAD_REF:-}" in
    release-please--*) python3 scripts/check-wiki.py --strict ;;
    *) python3 scripts/check-wiki.py ;;
esac

# release-please writes the version on the line marked x-release-please-version.
VERSION_FILE=[% if has_cli %]internal/version/version.go[% else %]version.go[% endif +%]
VERSION=$(sed -n 's/^const Version = "\([^"]*\)" *\/\/ *x-release-please-version.*/\1/p' "$VERSION_FILE" | head -n 1)
MANIFEST=$(python3 -c 'import json; print(json.load(open(".release-please-manifest.json"))["."])')
[ -n "$VERSION" ] \
    || { echo "error: $VERSION_FILE: no line \`const Version = \"X.Y.Z\" // x-release-please-version\`"; exit 1; }
echo "$VERSION" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.-]+)?$' \
    || { echo "error: $VERSION_FILE: version $VERSION is not semver"; exit 1; }
[ "$VERSION" = "$MANIFEST" ] \
    || { echo "error: $VERSION_FILE ($VERSION) and .release-please-manifest.json ($MANIFEST) disagree: only release-please changes them"; exit 1; }
[% if 'docker' in contrib or 'k8s' in contrib %]

# contrib's docker and k8s manifests come from template-container, rendered from this
# stack's `contrib` answer.
[ -f .copier-answers.container.yml ] \
    || { echo "error: contrib names docker or k8s, but template-container isn't applied: uvx copier copy --trust gh:andronics/template-container ."; exit 1; }
[% endif %]
echo "20-go OK"
